{
    "name": "inertiaui-notifications",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11.5.0"
    },
    "scripts": {
        "build": "pnpm run build:vue && pnpm run build:react",
        "build:vue": "pnpm --filter @inertiaui/notifications-vue build",
        "build:react": "pnpm --filter @inertiaui/notifications-react build",
        "build:demo": "pnpm --filter demo-app build",
        "dev:vue": "pnpm --filter @inertiaui/notifications-vue dev",
        "dev:react": "pnpm --filter @inertiaui/notifications-react dev",
        "dev:demo:vue": "pnpm --filter demo-app dev:vue",
        "dev:demo:react": "pnpm --filter demo-app dev:react",
        "docs:dev": "pnpm --filter inertiaui-notifications-docs docs:dev",
        "docs:build": "pnpm --filter inertiaui-notifications-docs docs:build",
        "docs:guide": "node scripts/boost-guide.mjs",
        "docs:guide:check": "node scripts/boost-guide.mjs --check",
        "typecheck": "pnpm run typecheck:vue && pnpm run typecheck:react",
        "typecheck:vue": "pnpm --filter @inertiaui/notifications-vue typecheck",
        "typecheck:react": "pnpm --filter @inertiaui/notifications-react typecheck",
        "typecheck:demo": "pnpm --filter demo-app run type-check:vue && pnpm --filter demo-app run type-check:react",
        "test:unit": "vp test run",
        "pack:check": "node scripts/check-package-surface.mjs",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "lint": "vp lint --fix",
        "lint:check": "vp lint"
    },
    "devDependencies": {
        "@inertiajs/core": "^3.11.0",
        "@inertiajs/react": "^3.11.0",
        "@inertiajs/vue3": "^3.11.0",
        "@inertiaui/vanilla": "^1.7.0",
        "@microsoft/api-extractor": "^7.60.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwind-merge": "^3.7.0",
        "typescript": "^6.0.3",
        "unplugin-dts": "^1.1.2",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.5.35",
        "vue-tsc": "^3.3.2"
    }
}
