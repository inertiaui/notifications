/docs/.vitepress/cache
/docs/.vitepress/dist
/docs/.vitepress/dist-ci
/docs/dist

# Laravel (demo-app)
/demo-app/bootstrap/cache/*.php
/demo-app/database/*.sqlite
/demo-app/storage/*.key

