{
    "name": "demo-app",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:vue": "vp dev --config vite.vue.config.ts",
        "dev:react": "vp dev --config vite.react.config.ts",
        "build:vue": "vp build --config vite.vue.config.ts",
        "build:react": "vp build --config vite.react.config.ts",
        "build": "pnpm run build:vue && pnpm run build:react",
        "type-check:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
        "type-check:react": "tsc --noEmit -p tsconfig.react.json"
    },
    "dependencies": {
        "@inertiaui/notifications-react": "workspace:*",
        "@inertiaui/notifications-vue": "workspace:*",
        "playwright": "^1.60.0"
    },
    "devDependencies": {
        "@inertiajs/react": "^3.11.0",
        "@inertiajs/vue3": "^3.11.0",
        "@radix-ui/react-dialog": "^1.3.1",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "laravel-vite-plugin": "^3.1.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "reka-ui": "^2.11.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.5.35",
        "vue-tsc": "^3.3.2"
    }
}
