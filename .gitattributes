# Composer archive policy for inertiaui/notifications.
#
# The Composer package is rooted at the repository root so the built Vue and
# React package folders ship under vendor/inertiaui/notifications/{vue,react}.
# Exclude CI, docs, the demo app, local tooling, and PHP dev-only files.
/.github             export-ignore
/.agents             export-ignore
/.amp                export-ignore
/.DS_Store           export-ignore
/.editorconfig       export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.php-cs-fixer.dist.php export-ignore
/AGENTS.md           export-ignore
/CLAUDE.md           export-ignore
/demo-app            export-ignore
/docs                export-ignore
/js/**/*.test.ts     export-ignore
/node_modules        export-ignore
/package.json        export-ignore
/phpstan.neon.dist   export-ignore
/phpunit.xml.dist    export-ignore
/pint.json           export-ignore
/pnpm-lock.yaml      export-ignore
/pnpm-workspace.yaml export-ignore
/rector.php          export-ignore
/release.sh          export-ignore
/scripts             export-ignore
/testbench.yaml      export-ignore
/tests               export-ignore
/vite.config.ts      export-ignore
/wrangler.jsonc      export-ignore

/react/dist/*.d.ts whitespace=cr-at-eol
/vue/dist/*.d.ts   whitespace=cr-at-eol
