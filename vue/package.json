{
    "name": "@inertiaui/notifications-vue",
    "version": "1.0.3",
    "description": "Vue components for Inertia Notifications",
    "keywords": [
        "inertia",
        "inertiajs",
        "laravel",
        "vue",
        "notifications",
        "notification-center",
        "toast",
        "toasts",
        "tailwindcss"
    ],
    "homepage": "https://inertiaui.com/inertia-notifications/docs",
    "bugs": {
        "url": "https://github.com/inertiaui/notifications/issues"
    },
    "author": "Pascal Baljet <pascal@protone.media>",
    "license": "MIT",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/inertiaui/notifications.git",
        "directory": "vue"
    },
    "type": "module",
    "files": [
        "dist",
        "shadcn.css",
        "theme.css"
    ],
    "module": "./dist/inertiaui-notifications.js",
    "types": "./dist/inertiaui-notifications.d.ts",
    "exports": {
        ".": {
            "types": "./dist/inertiaui-notifications.d.ts",
            "import": "./dist/inertiaui-notifications.js"
        },
        "./theme.css": "./theme.css",
        "./shadcn.css": "./shadcn.css"
    },
    "scripts": {
        "dev": "vp build --watch",
        "build": "vp build",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@inertiaui/vanilla": "^1.7.0",
        "tailwind-merge": "^3.7.0"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3.11.0",
        "vue": "^3.5.0"
    },
    "sideEffects": [
        "*.css"
    ]
}
